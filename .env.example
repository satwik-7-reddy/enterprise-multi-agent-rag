APP_NAME=enterprise-multi-agent-rag
APP_ENV=development
LOG_LEVEL=INFO

# LLM provider: openai (default) or bedrock.
LLM_PROVIDER=openai
OPENAI_CHAT_MODEL=gpt-4o-mini
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
LLM_MAX_TOKENS=1024

# Embedding provider: bedrock (default) or openai.
EMBEDDING_PROVIDER=bedrock

# Bedrock uses the standard Boto3 credential provider chain.
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
BEDROCK_EMBEDDING_NORMALIZE=true
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# OpenAI is only required when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Add other provider credentials only to a local .env file or secrets manager.
ANTHROPIC_API_KEY=
